{
  "rules": {
    "orders": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      "$orderId": {
        ".read": true,
        ".write": "!data.exists() && newData.hasChildren(['orderId','name','phone','address','books','total','status','createdAt']) && newData.child('status').val() === 'pending'",
        ".validate": "$orderId.length < 40 && newData.child('orderId').val() === $orderId",
        "orderId":     { ".validate": "newData.isString()" },
        "name":        { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "phone":       { ".validate": "newData.isString() && newData.val().matches(/^01[3-9][0-9]{8}$/)" },
        "address":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
        "books":       { ".validate": "newData.isString() && newData.val().length <= 3000" },
        "total":       { ".validate": "newData.isString() && newData.val().length <= 20" },
        "status":      { ".validate": "newData.val() === 'pending'" },
        "createdAt":   { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
        "payment":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "delivery":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "discount":    { ".validate": "newData.isNumber()" },
        "discountPct": { ".validate": "newData.isNumber()" },
        "coupon":      { ".validate": "newData.isString() && newData.val().length <= 30" },
        "couponType":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "customerNote":{ ".validate": "newData.isString() && newData.val().length <= 500" },
        "userId":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "items": {
          "$idx": {
            "name":  { ".validate": "newData.isString() && newData.val().length <= 200" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },

    "phoneIndex": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      "$phone": {
        ".read": true,
        "$orderId": {
          ".write": "!data.exists() && newData.val() === true"
        }
      }
    },

    "usedCoupons": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      "$coupon": {
        "$phone": {
          ".read": true,
          ".write": "!data.exists() && newData.val() === true"
        }
      }
    },

    "reviews": {
      ".read": true,
      "$bookId": {
        "$reviewId": {
          ".write": "(!data.exists() && newData.hasChildren(['name','comment','rating','createdAt'])) || (auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists()))",
          "helpful": {
            ".write": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "comment": { ".validate": "newData.isString() && newData.val().length <= 2000" }
        }
      }
    },

    "views": {
      "$bookId": {
        ".read": true,
        ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
      }
    },

    "stock": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "stockNotify": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      "$bookId": {
        "$phone": {
          ".write": "!data.exists() && newData.hasChildren(['phone','bookName','requestedAt'])",
          "phone": { ".validate": "newData.isString() && newData.val().matches(/^01[3-9][0-9]{8}$/)" },
          "bookName": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" }
        }
      }
    },

    "leaderboard": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "bookList": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "bookDescs": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "coupons": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "blogSubmissions": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      "$id": {
        ".write": "!data.exists() && newData.hasChildren(['name','title','content','createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 15" },
        "title": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 120" },
        "content": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20000" }
      }
    },

    "publishedBlogs": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "siteConfig": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "adminNotes": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "banners": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())"
    },

    "recentSales": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.hasChildren(['area','book','t'])) || (auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists()))",
        "area": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "book": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "courierApiKeys": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'"
    },

    "imgbbKey": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'"
    },

    "adminConfig": {
      ".read": "auth != null && (auth.token.email === 'alazizbookshop@gmail.com' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'"
    },

    "moderators": {
      ".read": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'",
      ".write": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "modRequests": {
      ".read": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'",
      ".write": "auth != null && auth.token.email === 'alazizbookshop@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.hasChildren(['email','name','t'])",
        "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'alazizbookshop@gmail.com')",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
